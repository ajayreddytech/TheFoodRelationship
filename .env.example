NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried in order if the primary model is unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Optional backup AI (Groq), used only when Gemini is down. Server-only. Keys: https://console.groq.com/keys
GROQ_API_KEY=
# Optional, comma-separated chat models for the backup, tried in order. Default openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b.
# Groq retires models regularly; current list and deprecations: https://console.groq.com/docs/models
GROQ_MODELS=
